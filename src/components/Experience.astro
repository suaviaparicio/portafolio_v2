---
import ExperienceItem  from "./ExperienceItem.astro";
import WebIcon from "./icons/experience/Web.astro";
import ProjectIcon from "./icons/experience/Project.astro";
import EngineernIcon from "./icons/experience/Engineer.astro";

const { translateLabels } = Astro.props;

const EXPERIENCE = [
    {
        title: translateLabels("home.experience.card1.title"),
        description: translateLabels("home.experience.card1.description"),
        icon: WebIcon,
    },
    {
        title: translateLabels("home.experience.card2.title"),
        description: translateLabels("home.experience.card2.description"),
        icon: ProjectIcon,
    },
    {
        title: translateLabels("home.experience.card3.title"),
        description: translateLabels("home.experience.card3.description"),
        icon: EngineernIcon,
    },
]
---
<div class="grid grid-cols-1 md:grid-cols-3 gap-4">
    {
        EXPERIENCE.map(experience => (
            <article class="experience-card group m-h-64 w-full p-5 mb-10 border-l-2 border-t-2 border-r-2 border-b-[11px] border-[#575757] transition-all duration-400 ease-in-out hover:scale-105 hover:border-b-[#A9D6E0] grid-cols-1 md:grid-cols-2">
                <experience.icon class="group-hover:text-[#A9D6E0]" />
                <ExperienceItem {...experience} />
            </article>
        ))
    }
</div>


